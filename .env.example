# 배포 도메인 (sitemap / canonical 에 사용)
NEXT_PUBLIC_SITE_URL=https://jaebwa.com

# Google AdSense 퍼블리셔 ID (ca-pub-...). 비우면 광고 영역이 렌더링되지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 쿠팡파트너스 API (Phase 3). 서버 전용 — NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
# 실제 값은 .env.local 에만 두고 저장소에 commit 하지 않는다.
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
